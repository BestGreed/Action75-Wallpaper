              [
                54,
                222,
                216
              ],
              [
                104,
                198,
                255
              ],
              [
                160,
                243,
                238
              ]
            ]
          },
          "maxColors": 9,
          "binding": {
            "target": "effectPalette"
          },
          "allowSingleHue": true,
          "palettes": [
            {
              "id": "sea-ice",
              "name": "海冰",
              "colors": [
                [
                  54,
                  222,
                  216
                ],
                [
                  104,
                  198,
                  255
                ],
                [
                  160,
                  243,
                  238
                ]
              ]
            },
            {
              "id": "aurora-sea",
              "name": "极光海",
              "colors": [
                [
                  67,
                  226,
                  180
                ],
                [
                  123,
                  208,
                  232
                ],
                [
                  187,
                  167,
                  255
                ]
              ]
            },
            {
              "id": "warm-current",
              "name": "暖流",
              "colors": [
                [
                  255,
                  211,
                  125
                ],
                [
                  255,
                  165,
                  111
                ],
                [
                  127,
                  224,
                  220
                ]
              ]
            }
          ],
          "surface": "foreground",
          "advanced": false,
          "appearance": "color"
        },
        {
          "id": "saturation",
          "type": "slider",
          "label": "饱和度",
          "default": 55,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectSaturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          },
          "surface": "foreground",
          "advanced": false,
          "appearance": "saturation"
        },
        {
          "id": "hue",
          "type": "slider",
          "label": "前景色相",
          "default": 0,
          "min": -180,
          "max": 180,
          "step": 1,
          "surface": "foreground",
          "appearance": "hue",
          "advanced": false,
          "unit": "°",
          "binding": {
            "target": "effectHue"
          }
        }
      ]
    },
    {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundStyle",
          "type": "select",
          "label": "背景样式",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "原作背景"
            },
            {
              "value": 1,
              "label": "纯色"
            }
          ],
          "binding": {
            "target": "background.style"
          },
          "surface": "background",
          "appearance": "style",
          "advanced": false
        },
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "亮度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "brightness"
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "saturation"
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "hue"
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "颜色",
          "default": [
            255,
            255,
            255
          ],
          "binding": {
            "target": "background.color"
          },
          "surface": "background",
          "advanced": false,
          "appearance": "color",
          "visibleWhen": {
            "id": "backgroundStyle",
            "equals": 0
          }
        },
        {
          "id": "backgroundSolidColor",
          "type": "color",
          "label": "纯色背景颜色",
          "default": [
            11,
            34,
            43
          ],
          "binding": {
            "target": "background.solidColor"
          },
          "visibleWhen": {
            "id": "backgroundStyle",
            "equals": 1
          },
          "surface": "background",
          "appearance": "color",
          "advanced": false
        }
      ]
    }
  ],
  "presentation": "layered"
}
