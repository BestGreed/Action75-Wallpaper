{
  "version": 1,
  "groups": [
    {
      "id": "appearance",
      "label": "外观",
      "controls": [
        {
          "id": "brightness",
          "type": "slider",
          "label": "波纹亮度",
          "default": 70,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectBrightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          },
          "surface": "foreground",
          "advanced": false,
          "appearance": "brightness"
        },
        {
          "id": "size",
          "type": "slider",
          "label": "波纹范围",
          "default": 1.25,
          "min": 0.5,
          "max": 3,
          "step": 0.05,
          "binding": {
            "target": "effectScale"
          },
          "unit": "×",
          "surface": "foreground",
          "advanced": false
        }
      ]
    },
    {
      "id": "motion",
      "label": "动效",
      "controls": [
        {
          "id": "duration",
          "type": "slider",
          "label": "扩散时长",
          "default": 0.82,
          "min": 0.2,
          "max": 2.5,
          "step": 0.01,
          "binding": {
            "target": "sprite.duration"
          },
          "unit": "秒",
          "surface": "foreground",
          "advanced": false
        }
      ]
    },
    {
      "id": "color",
      "label": "颜色",
      "controls": [
        {
          "id": "palette",
          "type": "palette",
          "label": "配色",
