                ],
                [
                  255,
                  222,
                  159
                ],
                [
                  255,
                  246,
                  217
                ]
              ]
            },
            {
              "id": "ice-jade",
              "name": "青绿 × 冰蓝",
              "colors": [
                [
                  73,
                  242,
                  168
                ],
                [
                  75,
                  177,
                  255
                ],
                [
                  199,
                  242,
                  255
                ]
              ]
            },
            {
              "id": "rose-lilac",
              "name": "玫红 × 藕紫",
              "colors": [
                [
                  255,
                  79,
                  155
                ],
                [
                  161,
                  116,
                  255
                ],
                [
                  255,
                  183,
                  207
                ]
              ]
            },
            {
              "id": "embers",
              "name": "朱红 × 琥珀",
              "colors": [
                [
                  255,
                  69,
                  73
                ],
                [
                  255,
                  150,
                  70
                ],
                [
                  255,
                  216,
                  134
                ]
              ]
            },
            {
              "id": "silver",
              "name": "月白 × 靛蓝",
              "colors": [
                [
                  208,
                  232,
                  255
                ],
                [
                  94,
                  133,
                  255
                ],
                [
                  245,
                  248,
                  255
                ]
              ]
            }
          ],
          "surface": "foreground",
          "visibleWhen": {
            "id": "randomPalette",
            "equals": false
          },
          "binding": {
            "target": "effectPalette"
          },
          "appearance": "color",
          "advanced": false
        },
        {
          "id": "brightness",
          "label": "烟花亮度",
          "type": "slider",
          "default": 1,
          "min": 0,
          "max": 2.5,
          "step": 0.05,
          "unit": "×",
          "surface": "foreground",
          "binding": {
            "target": "effectBrightness"
          },
          "appearance": "brightness",
          "advanced": false
        },
        {
          "id": "size",
          "label": "绽放范围",
          "type": "slider",
          "default": 3.5,
          "min": 0.5,
          "max": 6,
          "step": 0.05,
          "unit": "×",
          "surface": "foreground",
          "binding": {
            "target": "fireworks.spread"
          }
        },
        {
          "id": "speed",
          "label": "播放速度",
          "type": "slider",
          "default": 1,
          "min": 0.55,
          "max": 1.8,
          "step": 0.05,
          "unit": "×",
          "surface": "foreground",
          "binding": {
            "target": "effect.speed"
          }
        },
        {
          "id": "quality",
          "label": "细节档位",
          "type": "select",
          "default": 1,
          "options": [
            {
              "value": 0,
              "label": "省电"
            },
            {
              "value": 1,
              "label": "标准"
            },
            {
              "value": 2,
              "label": "高细节"
            }
          ],
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.quality"
          }
        },
        {
          "id": "density",
          "label": "火星密度",
          "type": "slider",
          "default": 0.82,
          "min": 0.25,
          "max": 1,
          "step": 0.01,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.density"
          }
        },
        {
          "id": "trail",
          "label": "拖尾长度",
          "type": "slider",
          "default": 1,
          "min": 0,
          "max": 1.6,
          "step": 0.05,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.trail"
          }
        },
        {
          "id": "gravity",
          "label": "下坠幅度",
          "type": "slider",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.gravity"
          }
        },
        {
          "id": "lifetime",
          "label": "燃烧时长",
          "type": "slider",
          "default": 1,
          "min": 0.55,
          "max": 1.5,
          "step": 0.05,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.lifetime"
          }
        },
        {
          "id": "shimmer",
          "label": "火星闪烁",
          "type": "slider",
          "default": 0.85,
          "min": 0,
          "max": 1,
          "step": 0.05,
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.shimmer"
          }
        },
        {
          "id": "embers",
          "label": "碎余烬",
          "type": "slider",
          "default": 1,
          "min": 0,
          "max": 1.5,
          "step": 0.05,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.embers"
          }
        },
        {
          "id": "bloom",
          "label": "辉光",
          "type": "slider",
          "default": 0.82,
          "min": 0,
          "max": 1.5,
          "step": 0.01,
          "unit": "×",
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.bloom"
          }
        },
        {
          "id": "smoke",
          "label": "亮起的烟雾",
          "type": "slider",
          "default": 0.55,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "advanced": true,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.smoke"
          }
        },
        {
          "id": "effectHue",
          "label": "色相",
          "type": "slider",
          "surface": "foreground",
          "appearance": "hue",
          "advanced": false,
          "binding": {
            "target": "effectHue"
          },
          "default": 0,
          "min": -180,
          "max": 180,
          "step": 1,
          "unit": "°"
        },
        {
          "id": "effectSaturation",
          "label": "饱和度",
          "type": "slider",
          "surface": "foreground",
          "appearance": "saturation",
          "advanced": false,
          "binding": {
            "target": "effectSaturation"
          },
          "default": 1,
          "min": 0,
          "max": 2.5,
          "step": 0.05,
          "unit": "×"
        }
      ],
      "entity": "烟花"
    },
    {
      "id": "night",
      "label": "夜景",
      "controls": [
        {
          "id": "backgroundBrightness",
          "label": "夜景亮度",
          "type": "slider",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "surface": "background",
          "binding": {
            "target": "background.brightness"
          },
          "appearance": "brightness",
          "advanced": false
        },
        {
          "id": "backgroundTint",
          "label": "夜景色调",
          "type": "color",
          "default": [
            235,
            243,
            255
          ],
          "surface": "background",
          "binding": {
            "target": "background.color"
          },
          "appearance": "color",
          "advanced": false
        },
        {
          "id": "reflection",
          "label": "水面倒影",
          "type": "slider",
          "default": 0.56,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "advanced": true,
          "surface": "background",
          "binding": {
            "target": "fireworks.reflection"
          }
        },
        {
          "id": "horizon",
          "label": "水线位置",
          "type": "slider",
          "default": 87,
          "min": 69,
          "max": 96,
          "step": 1,
          "unit": "%",
          "advanced": true,
          "surface": "background",
          "binding": {
            "target": "fireworks.horizon",
            "mapping": {
              "type": "linear",
              "inputMin": 69,
              "inputMax": 96,
              "outputMin": 0.69,
              "outputMax": 0.96
            }
          }
        },
        {
          "id": "backgroundStyle",
          "label": "背景样式",
          "type": "select",
          "surface": "background",
          "appearance": "style",
          "advanced": false,
          "binding": {
            "target": "background.style"
          },
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "暮色山湖"
            },
            {
              "value": 1,
              "label": "纯色"
            }
          ]
        },
        {
          "id": "backgroundHue",
          "label": "色相",
          "type": "slider",
          "surface": "background",
          "appearance": "hue",
          "advanced": false,
          "binding": {
            "target": "background.hue"
          },
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°"
        },
        {
          "id": "backgroundSaturation",
          "label": "饱和度",
          "type": "slider",
          "surface": "background",
          "appearance": "saturation",
          "advanced": false,
          "binding": {
            "target": "background.saturation"
          },
          "default": 1,
          "min": 0,
          "max": 2.5,
          "step": 0.05,
          "unit": "×"
        }
      ],
      "entity": "夜景与水面"
    }
  ]
}
