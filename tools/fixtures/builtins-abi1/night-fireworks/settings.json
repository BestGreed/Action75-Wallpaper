{
  "version": 1,
  "presentation": "layered",
  "groups": [
    {
      "id": "playback",
      "label": "播放花型",
      "presentation": "variant-playback",
      "playback": {
        "selection": "shape",
        "randomize": "shuffle",
        "interval": "keyInterval",
        "order": [
          1,
          4,
          8,
          2,
          7,
          3,
          5,
          6,
          9,
          10
        ]
      },
      "controls": [
        {
          "id": "shape",
          "label": "花型",
          "type": "select",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "组合轮换"
            },
            {
              "value": 1,
              "label": "锦冠垂柳",
              "toggleId": "useWillow"
            },
            {
              "value": 2,
              "label": "三重芯变色菊",
              "toggleId": "useChrys"
            },
            {
              "value": 3,
              "label": "双色牡丹",
              "toggleId": "usePeony"
            },
            {
              "value": 4,
              "label": "蓝银棕榈",
              "toggleId": "usePalm"
            },
            {
              "value": 5,
              "label": "万华镜",
              "toggleId": "useKaleidoscope"
            },
            {
              "value": 6,
              "label": "千轮菊",
              "toggleId": "useBouquet"
            },
            {
              "value": 7,
              "label": "土星环",
              "toggleId": "useSaturn"
            },
            {
              "value": 8,
              "label": "心形",
              "toggleId": "useHeart"
            },
            {
              "value": 9,
              "label": "金丝风车",
              "toggleId": "usePinwheel"
            },
            {
              "value": 10,
              "label": "星瓣大丽花",
              "toggleId": "useDahlia"
            }
          ],
          "surface": "foreground",
          "binding": {
            "target": "fireworks.shape"
          }
        },
        {
          "id": "shuffle",
          "label": "随机抽取花型",
          "type": "toggle",
          "default": false,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.shuffle"
          }
        },
        {
          "id": "useWillow",
          "label": "轮换 · 锦冠垂柳",
          "type": "toggle",
          "default": true,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.willow"
          }
        },
        {
          "id": "useChrys",
          "label": "轮换 · 三重芯变色菊",
          "type": "toggle",
          "default": true,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.chrys"
          }
        },
        {
          "id": "usePeony",
          "label": "轮换 · 双色牡丹",
          "type": "toggle",
          "default": true,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.peony"
          }
        },
        {
          "id": "usePalm",
          "label": "轮换 · 蓝银棕榈",
          "type": "toggle",
          "default": true,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.palm"
          }
        },
        {
          "id": "useKaleidoscope",
          "label": "轮换 · 万华镜",
          "type": "toggle",
          "default": false,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.kaleidoscope"
          }
        },
        {
          "id": "useBouquet",
          "label": "轮换 · 千轮菊",
          "type": "toggle",
          "default": false,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.bouquet"
          }
        },
        {
          "id": "useSaturn",
          "label": "轮换 · 土星环",
          "type": "toggle",
          "default": false,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.saturn"
          }
        },
        {
          "id": "useHeart",
          "label": "轮换 · 心形",
          "type": "toggle",
          "default": true,
          "advanced": true,
          "surface": "foreground",
          "visibleWhen": {
            "id": "shape",
            "equals": 0
          },
          "binding": {
            "target": "fireworks.heart"
          }
        },
        {
          "id": "keyInterval",
          "label": "击键触发间隔",
          "type": "slider",
          "default": 1,
          "min": 1,
          "max": 1000000,
          "step": 1,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.keyInterval"
          }
        },
        {
          "id": "usePinwheel",
          "type": "toggle",
          "label": "轮换 · 金丝风车",
          "default": true
        },
        {
          "id": "useDahlia",
          "type": "toggle",
          "label": "轮换 · 星瓣大丽花",
          "default": true
        }
      ],
      "entity": "烟花"
    },
    {
      "id": "bursts",
      "label": "烟花",
      "controls": [
        {
          "id": "randomPalette",
          "label": "随机轮换配色",
          "type": "toggle",
          "default": false,
          "surface": "foreground",
          "binding": {
            "target": "fireworks.randomPalette"
          },
          "appearance": "color",
          "advanced": false
        },
        {
          "id": "colors",
