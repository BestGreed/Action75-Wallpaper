{
  "version": 1,
  "presentation": "layered",
  "groups": [
    {
      "id": "sonar",
      "label": "光环",
      "controls": [
        {
          "id": "glow",
          "type": "slider",
          "label": "亮度",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "appearance": "brightness",
          "binding": {
            "target": "effectBrightness"
          }
        },
        {
          "id": "reach",
          "label": "扩散范围",
          "type": "slider",
          "default": 1,
          "min": 0.5,
          "max": 1.4,
          "step": 0.05,
          "unit": "×",
          "binding": {
            "target": "effectScale"
          },
          "surface": "foreground"
        }
      ],
      "entity": "光环"
    },
    {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundStyle",
          "type": "select",
          "label": "背景",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "原作"
            },
            {
              "value": 1,
              "label": "纯色"
            }
          ],
          "appearance": "style",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.style",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "背景亮度",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "appearance": "brightness",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "背景色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "appearance": "hue",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "背景饱和度",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "appearance": "saturation",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "背景颜色",
          "default": [
            255,
            255,
            255
          ],
          "appearance": "color",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.color"
          }
        }
      ],
      "entity": "底板"
    }
  ]
}
