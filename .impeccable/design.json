      "html": "<div class=\"ds-graphite\"><button type=\"button\" class=\"ds-graphite-button\">启动壁纸</button></div>",
      "css": ".ds-graphite{background:#1c1c1c;padding:9px}.ds-graphite-button{font:14px \"Microsoft YaHei\",sans-serif;color:#f0f0f0;background:#393939;border:1px solid #686868;border-radius:5px;padding:7px 12px}.ds-graphite-button:hover{background:#424242}.ds-graphite-button:active{background:#4e4e4e}.ds-graphite-button:focus-visible{outline:1px solid #c0c0c0;outline-offset:2px}"
