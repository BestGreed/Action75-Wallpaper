{
  "version": 1,
  "groups": [
    {
      "id": "appearance",
      "label": "外观",
      "controls": [
        {
          "id": "brightness",
          "type": "slider",
          "label": "波纹亮度",
          "default": 70,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectBrightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          }
        },
        {
          "id": "size",
          "type": "slider",
          "label": "波纹范围",
          "default": 1.25,
          "min": 0.5,
          "max": 3,
          "step": 0.05,
          "binding": {
            "target": "effectScale"
          },
          "unit": "×"
        }
      ]
    },
    {
      "id": "motion",
      "label": "动效",
      "controls": [
        {
          "id": "duration",
          "type": "slider",
          "label": "扩散时长",
          "default": 0.82,
          "min": 0.2,
          "max": 2.5,
          "step": 0.01,
          "binding": {
            "target": "sprite.duration"
          },
          "unit": "秒"
        }
      ]
    },
    {
      "id": "color",
      "label": "颜色",
      "controls": [
        {
          "id": "palette",
          "type": "palette",
          "label": "配色",
          "default": {
            "preset": "sea-ice",
            "colors": [
              [
                54,
                222,
                216
              ],
              [
                104,
                198,
                255
              ],
              [
                160,
                243,
                238
              ]
            ]
          },
          "maxColors": 9,
          "binding": {
            "target": "effectPalette"
          },
          "allowSingleHue": true,
          "palettes": [
            {
              "id": "sea-ice",
              "name": "海冰",
              "colors": [
                [
                  54,
                  222,
                  216
                ],
                [
                  104,
                  198,
                  255
                ],
                [
                  160,
                  243,
                  238
                ]
              ]
            },
            {
              "id": "aurora-sea",
              "name": "极光海",
              "colors": [
                [
                  67,
                  226,
                  180
                ],
                [
                  123,
                  208,
                  232
                ],
                [
                  187,
                  167,
                  255
                ]
              ]
            },
            {
              "id": "warm-current",
              "name": "暖流",
              "colors": [
                [
                  255,
                  211,
                  125
                ],
                [
                  255,
                  165,
                  111
                ],
                [
                  127,
                  224,
                  220
                ]
              ]
            }
          ]
        },
        {
          "id": "saturation",
          "type": "slider",
          "label": "饱和度",
          "default": 55,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectSaturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          }
        }
      ]
    },
    {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "亮度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          }
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          }
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "颜色",
          "default": [
            255,
            255,
            255
          ],
          "binding": {
            "target": "background.color"
          }
        }
      ]
    }
  ]
}
