{
  "version": 1,
  "groups": [
    {
      "id": "appearance",
      "label": "外观",
      "controls": [
        {
          "id": "brightness",
          "type": "slider",
          "label": "光弧亮度",
          "default": 80,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectBrightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          }
        },
        {
          "id": "size",
          "type": "slider",
          "label": "轨道大小",
          "default": 1.6,
          "min": 0.5,
          "max": 3,
          "step": 0.05,
          "binding": {
            "target": "effectScale"
          },
          "unit": "×"
        }
      ]
    },
    {
      "id": "motion",
      "label": "动效",
      "controls": [
        {
          "id": "duration",
          "type": "slider",
          "label": "消散时长",
          "default": 0.9,
          "min": 0.2,
          "max": 3.0,
          "step": 0.01,
          "binding": {
            "target": "sprite.duration"
          },
          "unit": "秒"
        }
      ]
    },
    {
      "id": "color",
      "label": "颜色",
      "controls": [
        {
          "id": "palette",
          "type": "palette",
          "label": "配色",
          "default": {
            "preset": "corona",
            "colors": [
              [
                255,
                197,
                106
              ],
              [
                255,
                152,
                102
              ],
              [
                255,
                224,
                163
              ]
            ]
          },
          "maxColors": 9,
          "binding": {
            "target": "effectPalette"
          },
          "allowSingleHue": true,
          "palettes": [
            {
              "id": "corona",
              "name": "日冕",
              "colors": [
                [
                  255,
                  197,
                  106
                ],
                [
                  255,
                  152,
                  102
                ],
                [
                  255,
                  224,
                  163
                ]
              ]
            },
            {
              "id": "blueshift",
              "name": "蓝移",
              "colors": [
                [
                  114,
                  216,
                  242
                ],
                [
                  111,
                  168,
                  255
                ],
                [
                  181,
                  155,
                  255
                ]
              ]
            },
            {
              "id": "rose-nebula",
              "name": "玫瑰星云",
              "colors": [
                [
                  242,
                  153,
                  124
                ],
                [
                  232,
                  137,
                  170
                ],
                [
                  198,
                  160,
                  242
                ]
              ]
            }
          ]
        },
        {
          "id": "saturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectSaturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          }
        }
      ]
    },
    {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "亮度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          }
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          }
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "颜色",
          "default": [
            255,
            255,
            255
          ],
          "binding": {
            "target": "background.color"
          }
        }
      ]
    }
  ]
}
