{
  "panels": {
    "atlas": {
      "version": 1,
      "groups": [
        {
          "$include": "#/groups/atlas-appearance"
        },
        {
          "$include": "#/groups/atlas-motion"
        },
        {
          "$include": "#/groups/atlas-color"
        },
        {
          "$include": "#/groups/atlas-background"
        }
      ],
      "presentation": "layered"
    },
    "field": {
      "version": 1,
      "groups": [
        {
          "$include": "#/groups/field-background"
        },
        {
          "$include": "#/groups/field-color"
        },
        {
          "$include": "#/groups/field-movement"
        },
        {
          "$include": "#/groups/field-detail"
        },
        {
          "$include": "#/groups/performance"
        }
      ],
      "presentation": "layered"
    }
  },
  "groups": {
    "atlas-appearance": {
      "id": "appearance",
      "label": "外观",
      "controls": [
        {
          "$include": "#/controls/atlas-brightness"
        },
        {
          "$include": "#/controls/atlas-size"
        }
      ]
    },
    "atlas-motion": {
      "id": "motion",
      "label": "动效",
      "controls": [
        {
          "id": "duration",
          "type": "slider",
          "label": "闪光时长",
          "default": 0.7,
          "min": 0.12,
          "max": 1.5,
          "step": 0.01,
          "binding": {
            "target": "sprite.duration"
          },
          "unit": "秒",
          "surface": "foreground",
          "advanced": false
        }
      ]
    },
    "atlas-color": {
      "id": "color",
      "label": "颜色",
      "controls": [
        {
          "id": "palette",
          "type": "palette",
          "label": "配色",
          "default": {
            "preset": "prism-violet",
            "colors": [
              [
                181,
                140,
                255
              ],
              [
                199,
                125,
                255
              ],
              [
                136,
                168,
                255
              ]
            ]
          },
          "maxColors": 9,
          "binding": {
            "target": "effectPalette"
          },
          "allowSingleHue": true,
          "palettes": [
            {
              "id": "prism-violet",
              "name": "棱镜紫",
              "colors": [
                [
                  181,
                  140,
                  255
                ],
                [
                  199,
                  125,
                  255
                ],
                [
                  136,
                  168,
                  255
                ]
              ]
            },
            {
              "id": "polarized-cyan",
              "name": "偏振青",
              "colors": [
                [
                  87,
                  227,
                  212
                ],
                [
                  128,
                  184,
                  255
                ],
                [
                  212,
                  168,
                  255
                ]
              ]
            },
            {
              "id": "rose-electric",
              "name": "玫红电光",
              "colors": [
                [
                  255,
                  111,
                  175
                ],
                [
                  207,
                  141,
                  255
                ],
                [
                  255,
                  209,
                  138
                ]
              ]
            }
          ],
          "surface": "foreground",
          "advanced": false,
          "appearance": "color"
        },
        {
          "id": "saturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "effectSaturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          },
          "surface": "foreground",
          "advanced": false,
          "appearance": "saturation"
        },
        {
          "id": "hue",
          "type": "slider",
          "label": "前景色相",
          "default": 0,
          "min": -180,
          "max": 180,
          "step": 1,
          "surface": "foreground",
          "appearance": "hue",
          "advanced": false,
          "unit": "°",
          "binding": {
            "target": "effectHue"
          }
        }
      ]
    },
    "atlas-background": {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundStyle",
          "type": "select",
          "label": "背景样式",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "原作背景"
            },
            {
              "value": 1,
              "label": "纯色"
            }
          ],
          "binding": {
            "target": "background.style"
          },
          "surface": "background",
          "appearance": "style",
          "advanced": false
        },
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "亮度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "power",
              "inputMin": 0,
              "inputMax": 100,
              "outputMin": 0,
              "outputMax": 4,
              "exponent": 2
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "brightness"
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "饱和度",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "piecewise",
              "points": [
                [
                  0,
                  0
                ],
                [
                  50,
                  1
                ],
                [
                  100,
                  2.5
                ]
              ]
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "saturation"
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          },
          "surface": "background",
          "advanced": false,
          "appearance": "hue"
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "颜色",
          "default": [
            255,
            255,
            255
          ],
          "binding": {
            "target": "background.color"
          },
          "surface": "background",
          "advanced": false,
          "appearance": "color",
          "visibleWhen": {
            "id": "backgroundStyle",
            "equals": 0
          }
        },
        {
          "id": "backgroundSolidColor",
          "type": "color",
          "label": "纯色背景颜色",
          "default": [
            31,
            21,
            42
          ],
          "binding": {
            "target": "background.solidColor"
          },
          "visibleWhen": {
            "id": "backgroundStyle",
            "equals": 1
          },
          "surface": "background",
          "appearance": "color",
          "advanced": false
        }
      ]
    },
    "field-background": {
      "id": "background",
