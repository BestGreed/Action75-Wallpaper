      "appearance": "style",
      "advanced": false
    },
    "background-brightness": {
      "id": "brightness",
      "label": "背景亮度",
      "type": "slider",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "×",
      "surface": "background",
      "binding": {
        "target": "background.brightness"
      },
      "appearance": "brightness",
      "advanced": false
    },
    "conditional-brightness": {
      "id": "nebulaBrightness",
      "type": "slider",
      "label": "星云亮度",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "visibleWhen": {
        "id": "skyMode",
        "equals": 0
      },
      "binding": {
        "target": "blackHole.nebulaBrightness"
      },
      "surface": "background"
    },
    "conditional-speed": {
      "id": "nebulaSpeed",
      "type": "slider",
      "label": "星云漂移速度",
      "default": 0.75,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "×",
      "visibleWhen": {
        "id": "skyMode",
