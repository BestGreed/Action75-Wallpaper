  "controls": {
    "atlas-brightness": {
      "id": "brightness",
      "type": "slider",
      "label": "闪光亮度",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 1,
      "binding": {
        "target": "effectBrightness",
        "mapping": {
          "type": "power",
          "inputMin": 0,
          "inputMax": 100,
          "outputMin": 0,
          "outputMax": 4,
          "exponent": 2
        }
      },
      "surface": "foreground",
      "advanced": false,
      "appearance": "brightness"
    },
    "atlas-size": {
      "id": "size",
      "type": "slider",
      "label": "光斑大小",
      "default": 1.8,
      "min": 0.5,
      "max": 3,
      "step": 0.05,
      "binding": {
        "target": "effectScale"
      },
      "unit": "×",
      "surface": "foreground",
      "advanced": false
    },
    "impact-min": {
      "id": "impactMin",
      "label": "力度下限",
      "type": "slider",
      "default": 0.6,
      "min": 0,
      "max": 3.2,
      "step": 0.01,
      "unit": "×",
      "surface": "foreground",
      "binding": {
        "target": "glassShatter.impactMin"
      },
      "advanced": true
    },
    "impact-max": {
      "$include": "#/controls/impact-min",
      "id": "impactMax",
      "label": "力度上限",
      "default": 1.45,
      "binding": {
        "target": "glassShatter.impactMax"
      }
    },
    "backdrop": {
      "id": "backdrop",
      "label": "背景样式",
      "type": "select",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "极夜蓝"
        },
        {
          "value": 1,
          "label": "琥珀暮光"
        },
        {
