  "afterimage": {
    "$include": "library.json#/panels/atlas"
  },
  "black-hole": {
    "version": 1,
    "presentation": "layered",
    "groups": [
      {
        "$include": "../../../wallpapers-native/black-hole/settings.json#/groups/0"
      },
      {
        "$include": "../../../wallpapers-native/black-hole/settings.json#/groups/1",
        "controls": [
          {
            "$include": "library.json#/controls/background-choice",
            "id": "skyMode",
            "label": "远景背景",
            "options": [
              {
                "value": 0,
                "label": "星云"
              },
              {
                "value": 1,
                "label": "虚空"
              },
              {
                "value": 2,
                "label": "星空"
              }
            ],
            "binding": {
              "target": "blackHole.sky"
            }
          },
          {
            "$include": "library.json#/controls/conditional-brightness"
          },
          {
            "$include": "library.json#/controls/conditional-speed"
          },
          {
            "$include": "library.json#/controls/conditional-tint"
          },
          {
            "$include": "library.json#/controls/conditional-brightness",
            "id": "voidBrightness",
            "label": "虚空余辉",
            "visibleWhen": {
              "id": "skyMode",
              "equals": 1
            },
            "binding": {
              "target": "blackHole.voidBrightness"
            }
          },
          {
            "$include": "library.json#/controls/conditional-speed",
            "id": "voidSpeed",
            "label": "浮尘漂移速度",
            "default": 0.65,
            "visibleWhen": {
              "id": "skyMode",
              "equals": 1
            },
            "binding": {
              "target": "blackHole.voidSpeed"
            }
          },
          {
            "$include": "library.json#/controls/conditional-tint",
            "id": "voidTint",
            "label": "虚空色调",
            "visibleWhen": {
              "id": "skyMode",
              "equals": 1
            },
            "binding": {
              "target": "blackHole.voidTint"
            }
          },
          {
            "$include": "library.json#/controls/conditional-brightness",
            "id": "starfieldBrightness",
            "label": "星空亮度",
            "visibleWhen": {
              "id": "skyMode",
              "equals": 2
            },
            "binding": {
              "target": "blackHole.starfieldBrightness"
            }
          },
          {
            "$include": "library.json#/controls/conditional-speed",
            "id": "starfieldSpeed",
            "label": "星空动效速度",
            "default": 0.8,
            "visibleWhen": {
              "id": "skyMode",
              "equals": 2
            },
            "binding": {
              "target": "blackHole.starfieldSpeed"
            }
          },
          {
            "$include": "library.json#/controls/conditional-tint",
            "id": "starfieldTint",
            "label": "星空色调",
            "visibleWhen": {
              "id": "skyMode",
              "equals": 2
            },
            "binding": {
              "target": "blackHole.starfieldTint"
            }
          }
        ]
      },
      {
        "$include": "../../../wallpapers-native/black-hole/settings.json#/groups/2"
      }
    ]
  },
