{
  "version": 1,
  "presentation": "layered",
  "groups": [
    {
      "id": "flowers",
      "label": "焰花播放",
      "presentation": "variant-playback",
      "controls": [
        {
          "id": "flower",
          "label": "花型",
          "type": "select",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "组合"
            },
            {
              "value": 1,
              "label": "玫瑰心笺",
              "toggleId": "rose-letter"
            },
            {
              "value": 2,
              "label": "金丝垂柳",
              "toggleId": "gilded-willow"
            },
            {
              "value": 3,
              "label": "潮汐双环",
              "toggleId": "tidal-orbit"
            },
            {
              "value": 4,
              "label": "剪纸星菊",
              "toggleId": "paper-aster"
            },
            {
              "value": 5,
              "label": "青瓷牡丹",
              "toggleId": "porcelain-peony"
            },
            {
              "value": 6,
              "label": "翡翠棕榈",
              "toggleId": "jade-palm"
            },
            {
              "value": 7,
              "label": "棱镜风轮",
              "toggleId": "prism-wheel"
            },
            {
              "value": 8,
              "label": "锦簇花束",
              "toggleId": "festival-bouquet"
            }
          ],
          "surface": "foreground",
          "appearance": "style"
        },
        {
          "id": "rose-letter",
          "label": "玫瑰心笺",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "gilded-willow",
          "label": "金丝垂柳",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "tidal-orbit",
          "label": "潮汐双环",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "paper-aster",
          "label": "剪纸星菊",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "porcelain-peony",
          "label": "青瓷牡丹",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "jade-palm",
          "label": "翡翠棕榈",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "prism-wheel",
          "label": "棱镜风轮",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "festival-bouquet",
          "label": "锦簇花束",
          "type": "toggle",
          "default": true,
          "surface": "foreground"
        },
        {
          "id": "shuffle",
          "label": "随机次序",
          "type": "toggle",
          "default": false,
          "surface": "foreground"
        },
        {
          "id": "spacing",
          "label": "每几键开花",
          "type": "slider",
          "default": 1,
          "min": 1,
          "max": 99,
          "step": 1,
          "unit": "键",
          "surface": "foreground"
        }
      ],
      "playback": {
        "selection": "flower",
        "randomize": "shuffle",
        "interval": "spacing",
        "order": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    },
    {
      "id": "appearance",
      "label": "外观与节奏",
      "controls": [
        {
          "id": "size",
          "label": "花冠大小",
          "type": "slider",
          "default": 1,
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "binding": {
            "target": "effectScale"
          },
          "surface": "foreground"
        },
        {
          "id": "speed",
          "label": "展开速度",
          "type": "slider",
          "default": 1,
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "binding": {
            "target": "effect.speed"
          },
          "surface": "foreground"
        },
        {
          "id": "brightness",
          "label": "焰花亮度",
          "type": "slider",
          "default": 1,
          "min": 0.25,
          "max": 1,
          "step": 0.05,
          "unit": "×",
          "binding": {
            "target": "effectBrightness"
          },
          "surface": "foreground",
          "appearance": "brightness"
        }
      ]
    },
    {
      "id": "background",
      "label": "背景",
      "controls": [
        {
          "id": "backgroundStyle",
          "type": "select",
          "label": "背景",
          "default": 0,
          "options": [
            {
              "value": 0,
              "label": "原作"
            },
            {
              "value": 1,
              "label": "纯色"
            }
          ],
          "appearance": "style",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.style",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundBrightness",
          "type": "slider",
          "label": "背景亮度",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "appearance": "brightness",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.brightness",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundHue",
          "type": "slider",
          "label": "背景色相",
          "default": 0,
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "appearance": "hue",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.hue",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundSaturation",
          "type": "slider",
          "label": "背景饱和度",
          "default": 1,
          "min": 0,
          "max": 2,
          "step": 0.05,
          "unit": "×",
          "appearance": "saturation",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.saturation",
            "mapping": {
              "type": "identity"
            }
          }
        },
        {
          "id": "backgroundColor",
          "type": "color",
          "label": "背景颜色",
          "default": [
            255,
            255,
            255
          ],
          "appearance": "color",
          "surface": "background",
          "advanced": false,
          "binding": {
            "target": "background.color"
          }
        }
      ]
    }
  ]
}
