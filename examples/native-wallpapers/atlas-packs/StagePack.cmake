if(NOT DESTINATION OR NOT EXISTS "${ASSETS}/manifest.json" OR NOT EXISTS "${MODULE}")
  message(FATAL_ERROR "Missing source artwork or compiled wallpaper module")
endif()
get_filename_component(ASSETS "${ASSETS}" ABSOLUTE)
get_filename_component(DESTINATION "${DESTINATION}" ABSOLUTE)
if(ASSETS STREQUAL DESTINATION)
  message(FATAL_ERROR "Stage to a separate pack directory")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY "${ASSETS}/" DESTINATION "${DESTINATION}"
  PATTERN "wallpaper.dll" EXCLUDE PATTERN "manifest.json" EXCLUDE PATTERN "*.efkmatd" EXCLUDE)
if(MATERIALS)
  file(COPY "${MATERIALS}/" DESTINATION "${DESTINATION}/materials")
endif()
if(EXISTS "${PROJECT_LICENSE}")
  configure_file("${PROJECT_LICENSE}" "${DESTINATION}/LICENSE" COPYONLY)
endif()
if(EXISTS "${JSON_LICENSE}")
  configure_file("${JSON_LICENSE}" "${DESTINATION}/licenses/nlohmann-json.txt" COPYONLY)
endif()
if(EFFEKSEER_LICENSE_ROOT)
  configure_file("${EFFEKSEER_LICENSE_ROOT}/LICENSE.txt" "${DESTINATION}/licenses/Effekseer.txt" COPYONLY)
  configure_file("${EFFEKSEER_LICENSE_ROOT}/LICENSE_RUNTIME_DIRECTX.txt"
    "${DESTINATION}/licenses/Effekseer-DirectX.txt" COPYONLY)
  configure_file("${EFFEKSEER_LICENSE_ROOT}/src/3rdParty/LLGI/LICENSE" "${DESTINATION}/licenses/LLGI.txt" COPYONLY)
endif()
file(READ "${ASSETS}/manifest.json" manifest)
string(JSON abi GET "${manifest}" abi)
string(JSON renderer ERROR_VARIABLE missing_renderer GET "${manifest}" renderer)
if(abi EQUAL 2 AND renderer STREQUAL "d3d12")
  configure_file("${ASSETS}/manifest.json" "${DESTINATION}/manifest.json" COPYONLY)
else()
  string(JSON manifest SET "${manifest}" abi 2)
  string(JSON manifest SET "${manifest}" renderer "\"d3d12\"")
  file(WRITE "${DESTINATION}/manifest.json" "${manifest}\n")
endif()
configure_file("${MODULE}" "${DESTINATION}/wallpaper.dll" COPYONLY)
