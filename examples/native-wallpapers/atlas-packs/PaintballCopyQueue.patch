+ID3D12CommandQueue* GraphicsDX12::GetCommandQueue()
+{
+	// The host submits borrowed lists. Only full SDK submissions need this DIRECT queue.
+	if (!commandQueue_)
+	{
+		D3D12_COMMAND_QUEUE_DESC desc{};
+		if (FAILED(device_->CreateCommandQueue(&desc, IID_PPV_ARGS(&commandQueue_))))
+			throw std::runtime_error("Create Effekseer DX12 fallback queue");
+		if (FAILED(commandQueue_->GetTimestampFrequency(&timestampFrequency_)))
+		{
+			SafeRelease(commandQueue_);
+			throw std::runtime_error("Read Effekseer DX12 queue timestamp frequency");
+		}
+	}
+	return commandQueue_;
+}
